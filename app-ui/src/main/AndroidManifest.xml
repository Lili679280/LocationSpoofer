            android:name="com.vincenthzr.locationspoofer.viewmodel.NotificationStopReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.vincenthzr.locationspoofer.NOTIFICATION_STOP" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
